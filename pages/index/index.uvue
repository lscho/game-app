<template>
  <view class="page" :style="pageStyle">
    <view class="bg-sun"></view>
    <view class="bg-orb orb-a"></view>
    <view class="bg-orb orb-b"></view>

    <scroll-view class="scroll">
      <view class="content">
        <view class="header">
          <view class="logo-wrap">
            <image class="logo" src="/static/img/brand-icon.png" mode="aspectFit"></image>
          </view>
          <view class="brand">
            <text class="brand-name">欢乐游戏</text>
            <text class="brand-sub">甜甜的童年，天天有游戏</text>
          </view>
        </view>

        <view class="hero">
          <text class="hello">嗨，小玩家</text>
          <text class="hero-title">今天想玩什么？</text>
          <text class="hero-note">挑一个游戏，马上出发</text>
        </view>

        <view class="section-row">
          <text class="section-title">今日推荐</text>
          <text class="section-count">{{ games.length }} 个游戏</text>
        </view>

        <view
          class="game-card"
          v-for="game in games"
          :key="game.id"
          @click="openGame(game)"
        >
          <view class="cover" :style="'background-color:' + game.coverBg + ';' + coverStyle">
            <image class="cover-art" :src="game.cover" mode="aspectFill"></image>
            <view class="cover-badge" v-if="game.badge">
              <text class="cover-badge-text">{{ game.badge }}</text>
            </view>
          </view>

          <view class="game-body">
            <text class="game-name">{{ game.name }}</text>
            <text class="game-desc">{{ game.desc }}</text>
            <view class="meta-row">
              <view
                class="meta-chip"
                :style="'background-color:' + chip.bg"
                v-for="chip in game.chips"
                :key="chip.text"
              >
                <text class="meta-text">{{ chip.text }}</text>
              </view>
            </view>
            <view class="play-button" :style="'background-color:' + game.accent" @click.stop="openGame(game)">
              <text class="play-text">开始游戏</text>
              <text class="play-arrow">›</text>
            </view>
          </view>
        </view>

        <view class="coming">
          <view class="coming-marks">
            <view class="mark mark-pink"></view>
            <view class="mark mark-mint"></view>
            <view class="mark mark-lemon"></view>
          </view>
          <text class="coming-text">更多甜甜的小游戏正在准备中</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
const info = uni.getWindowInfo()
const safeTop = info.safeArea ? Math.max(0, info.safeArea.top) : 0
const safeBottom = info.safeArea
  ? Math.max(0, (info.windowHeight || info.screenHeight) - info.safeArea.bottom)
  : 0
const pageStyle = 'padding-top:' + (safeTop + 10) + 'px; padding-bottom:' + (safeBottom + 18) + 'px;'
// 封面图 900x640，按卡片实际宽度等比设置高度，避免 aspectFill 裁掉角色
const coverWidth = (info.windowWidth || 390) - 64
const coverStyle = 'height:' + Math.round((coverWidth * 640) / 900) + 'px;'

const games = [
  {
    id: 'orchard',
    name: '小兔子的彩虹果园',
    desc: '拖动小兔，接住彩虹水果',
    route: '/pages/game/game',
    cover: '/static/img/covers/orchard.png',
    coverBg: '#C7EDFF',
    accent: '#FF6F8E',
    badge: '人气游戏',
    chips: [
      { text: '接水果', bg: '#DEF7F1' },
      { text: '20 关', bg: '#FFF1C9' },
      { text: '4-7 岁', bg: '#FFE4EB' }
    ]
  },
  {
    id: 'bubble',
    name: '泡泡海洋',
    desc: '戳破泡泡，找出海洋朋友',
    route: '/pages/bubble/bubble',
    cover: '/static/img/covers/bubble.png',
    coverBg: '#BDEBFF',
    accent: '#2AA5DA',
    badge: '新游戏',
    chips: [
      { text: '戳泡泡', bg: '#DEF4FF' },
      { text: '16 关', bg: '#FFF1C9' },
      { text: '4-9 岁', bg: '#E3F8EE' }
    ]
  },
  {
    id: 'memory',
    name: '动物翻翻乐',
    desc: '翻一翻，找出一样的小动物',
    route: '/pages/memory/memory',
    cover: '/static/img/covers/memory.png',
    coverBg: '#A9E4FF',
    accent: '#E4718F',
    badge: '新游戏',
    chips: [
      { text: '记忆配对', bg: '#FFE7F0' },
      { text: '16 关', bg: '#FFF1C9' },
      { text: '4-9 岁', bg: '#E9EEFF' }
    ]
  },
  {
    id: 'band',
    name: '小小乐队',
    desc: '看乐谱，按顺序敲乐器',
    route: '/pages/band/band',
    cover: '/static/img/covers/band.png',
    coverBg: '#FFE6C2',
    accent: '#E38A3F',
    badge: '新游戏',
    chips: [
      { text: '音乐节奏', bg: '#FFF0D9' },
      { text: '16 关', bg: '#FFE9C9' },
      { text: '4-9 岁', bg: '#E3F8EE' }
    ]
  }
]

function openGame(game) {
  uni.navigateTo({ url: game.route })
}
</script>

